{
  "uid": "invoice-api-red",
  "title": "Invoice API - RED",
  "schemaVersion": 39,
  "version": 3,
  "tags": [
    "red",
    "go"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate: requests per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{job=\"invoice-api\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "exemplar": false
        }
      ],
      "description": "Rate: how many requests per second each route receives. Labels are route patterns like /invoices/{id}, never raw URLs."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors: share of 5xx by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total{job=\"invoice-api\",code=~\"5..\"}[$__rate_interval])) / sum by (route) (rate(http_requests_total{job=\"invoice-api\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "exemplar": false
        }
      ],
      "description": "Errors: the share of requests answered with a 5xx, per route. 0.001 (0.1%) is the whole error budget of a 99.9% SLO."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration: p50 / p95 / p99 (exemplars link to Jaeger)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"invoice-api\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"invoice-api\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"invoice-api\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ],
      "description": "Duration: how long requests take (p50, p95, p99). The diamonds are exemplars: click one to open its trace in Jaeger. Only errors and slow requests carry one, because those are the traces the Collector always keeps."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error budget burn rate (1 = on budget, 14.4 = page)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "job:slo_errors_per_request:ratio_rate5m / 0.001",
          "legendFormat": "5m",
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "job:slo_errors_per_request:ratio_rate1h / 0.001",
          "legendFormat": "1h",
          "exemplar": false
        }
      ],
      "description": "Burn rate: how fast the 30-day error budget is spent. 1 means exactly on budget; the page alert fires when both lines stay above 14.4."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Go runtime: goroutines and heap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_goroutines{job=\"invoice-api\"}",
          "legendFormat": "goroutines",
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "go_memstats_heap_inuse_bytes{job=\"invoice-api\"} / 1e6",
          "legendFormat": "heap in use (MB)",
          "exemplar": false
        }
      ],
      "description": "Go runtime: goroutines and heap in use, read from runtime/metrics. A steady climb usually means a leak."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Go runtime/metrics: scheduler latency and GC pauses (p99)",
      "description": "Read from runtime/metrics. Scheduler latency: how long a ready goroutine waits for a CPU (high means CPU saturation or a too small GOMAXPROCS). GC pauses: stop-the-world time per collection.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(go_sched_latencies_seconds_bucket{job=\"invoice-api\"}[$__rate_interval])))",
          "legendFormat": "scheduler latency p99",
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(go_gc_pauses_seconds_bucket{job=\"invoice-api\"}[$__rate_interval])))",
          "legendFormat": "GC pause p99",
          "exemplar": false
        }
      ]
    }
  ],
  "description": "RED method (Rate, Errors, Duration) for the invoice API, with exemplars linking latency to traces."
}
